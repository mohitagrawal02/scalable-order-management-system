# ============================================================================
# docker-compose.yml - variable template
# ============================================================================
# Compose reads a file named `.env` next to docker-compose.yml (this folder):
#   copy .env.example .env        (Windows)   cp .env.example .env   (bash)
#
# ONLY JWT_SECRET IS MANDATORY. Everything else has a local-development default
# so that `docker compose up` works on the first try - and none of those defaults
# is safe anywhere except in the throwaway local stack this file describes.
#
# This is NOT the backend's own env file. When the API runs directly on your
# machine (`npm run dev`) it reads backend/.env; inside Compose every setting
# arrives as a real environment variable instead. One mechanism per environment,
# so there is never a "which of my two .env files won?" question.
# ============================================================================

# ----------------------------------------------------------------------------
# Required. Signs and verifies every access token; generate your own:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Compose refuses to start without it, and config/index.ts additionally refuses
# to boot in production with a placeholder or a secret shorter than 32 chars.
# ----------------------------------------------------------------------------
JWT_SECRET=

# ----------------------------------------------------------------------------
# Optional: MySQL. Defaults are fine locally; the names match backend/.env so
# switching between the host's mysqld (127.0.0.1:3307) and the container
# (127.0.0.1:3308) is a host/port change and nothing else.
# ----------------------------------------------------------------------------
MYSQL_DATABASE=ecommerce_platform
MYSQL_USER=ecommerce_app
MYSQL_PASSWORD=ecommerce_dev_only
MYSQL_ROOT_PASSWORD=root_dev_only
# Host port the container's 3306 is published on. 3308 by default so this stack
# can run next to a local mysqld on 3306/3307 instead of fighting it.
MYSQL_HOST_PORT=3308

# ----------------------------------------------------------------------------
# Optional: published host ports for the other services
# ----------------------------------------------------------------------------
# The API. Drop it to 3000 if a future frontend proxies better to that.
API_HOST_PORT=4000
# Redis (the container's 6379). Only for inspecting the cache with redis-cli.
REDIS_HOST_PORT=6380
# Kafka's HOST listener. The in-network address the containers use is kafka:9092
# and is not published, because nothing outside this network could resolve it.
# Point a host-run API at it with: KAFKA_BROKERS=localhost:29092
KAFKA_HOST_PORT=29092

# ----------------------------------------------------------------------------
# Optional: application behaviour
# ----------------------------------------------------------------------------
# debug | info | warn | error | silent. debug also logs every cache hit/miss.
LOG_LEVEL=info
# Access-token lifetime: 15m, 1h, 7d.
JWT_EXPIRES_IN=15m
# Comma-separated browser origins allowed to call the API. NODE_ENV=production
# refuses to boot without this - wildcard CORS with credentials is a
# vulnerability, not a default. 5173 is the Vite dev-server origin the Day 10
# frontend will use.
CORS_ORIGINS=http://localhost:5173

# ----------------------------------------------------------------------------
# Optional: protecting GET /api/metrics
# ----------------------------------------------------------------------------
# Deliberately NOT wired into docker-compose.yml by default: with METRICS_TOKEN
# unset the endpoint is open, which is right for a stack that publishes on
# localhost and is exactly what you want while developing. On a real deployment
# the token belongs in the orchestrator's secret store, and to try it locally add
# `METRICS_TOKEN: ${METRICS_TOKEN}` to the x-app-env block in docker-compose.yml.
# The payload describes internal counters, backlogs and process ids.
# METRICS_TOKEN=some-long-random-string
