# ============================================================================
# Backend environment configuration (example / template)
# ============================================================================
# Copy this file to `.env` and fill in real values for your machine.
# Never commit the real `.env`.

DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"
PORT=4000
NODE_ENV=development

# ----------------------------------------------------------------------------
# JWT (JSON Web Token) configuration
# ----------------------------------------------------------------------------
# JWT_SECRET signs and verifies access tokens. MUST be a random value of at
# least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="replace-with-a-random-secret-at-least-32-chars-long"
# How long an access token stays valid: '15m', '1h', '7d' (or seconds).
JWT_EXPIRES_IN="15m"

# ----------------------------------------------------------------------------
# Redis (Day 6) - product catalog cache + login rate limiting
# ----------------------------------------------------------------------------
# Redis is an OPTIMISATION layer, not a requirement: if it is unreachable the
# API keeps working (cache misses fall back to MySQL, rate limiting fails
# open) and only logs the degradation. See docs/REDIS.md.
#
# Local development (any of these - your choice):
#   docker:  docker compose -f docker-compose.redis.yml up -d
#   windows: redis-server.exe --port 6379 --dir .\redis-local-data
REDIS_URL="redis://127.0.0.1:6379"

# Client-side per-command timeout (ms). A slower Redis is treated as a cache
# error, so a sick cache can never stall an HTTP request.
REDIS_COMMAND_TIMEOUT_MS=500

# ----------------------------------------------------------------------------
# Product catalog cache
# ----------------------------------------------------------------------------
# TTL (seconds) for cached product list/detail responses. This is the worst
# case staleness if an invalidation is ever missed: short = fresher but more
# MySQL load, long = cheaper but staler. 60s is a deliberate starting point.
PRODUCT_CACHE_TTL_SECONDS=60

# ----------------------------------------------------------------------------
# Login rate limiting
# ----------------------------------------------------------------------------
# Attempts allowed per (client IP + target account) inside the window below.
# 5 attempts / 60s is a DEVELOPMENT default for a learning project - it is not
# a universal security recommendation. Tune per environment and document why.
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# ----------------------------------------------------------------------------
# Kafka (Day 7) - asynchronous events via a transactional outbox
# ----------------------------------------------------------------------------
# Like Redis, Kafka is OPTIONAL infrastructure with working defaults: if the
# broker is down the API keeps serving requests and every event simply waits in
# the MySQL `outbox_events` table until it comes back. Kafka never sits on the
# request path, and its status never changes /api/health's overall status.
# See docs/KAFKA.md.
#
# Local broker (PowerShell - no Docker on this machine):
#   ..\infra\kafka\kafka.ps1 -Action start    # format once, launch KRaft broker
#   ..\infra\kafka\kafka.ps1 -Action status
#   ..\infra\kafka\kafka.ps1 -Action topics
#   ..\infra\kafka\kafka.ps1 -Action stop
# or the npm shortcuts: `npm run kafka:start|kafka:status|kafka:topics|kafka:stop`.
#
# Master switch. `false` disables the producer, the outbox dispatcher and the
# worker's consumers entirely - the escape hatch for running without a broker
# at all. The dispatcher will not even open a socket while this is false.
KAFKA_ENABLED=true

# Comma-separated host:port list.
KAFKA_BROKERS="127.0.0.1:9092"

# Identifies this process in broker logs and quotas.
KAFKA_CLIENT_ID="ecommerce-platform-backend"

# Consumer group that owns the notification worker. Changing it makes every
# worker re-read the log from its own beginning - deliberate for a rollout,
# an expensive accident otherwise.
KAFKA_NOTIFICATION_GROUP_ID="notification-service"

# Consumer retries for ONE message before it is dead-lettered. Transient
# failures (a database blip) recover inside this budget; a poison message must
# not stall its partition forever.
KAFKA_CONSUMER_MAX_ATTEMPTS=3
# First retry delay. From Day 8 it grows EXPONENTIALLY from here (250 -> 500 ->
# 1000 ...) up to the ceiling below, with +/-25% jitter so a recovered broker is
# not hit by every consumer at the same instant.
KAFKA_CONSUMER_RETRY_DELAY_MS=250
KAFKA_CONSUMER_RETRY_MAX_DELAY_MS=5000

# Outbox dispatcher budget, deliberately much larger than the consumer's: a
# broker outage is expected and recoverable, so events should WAIT rather than
# be abandoned. After this many attempts a row is parked as DEAD and shows up
# in `kafka.deadEvents` on /api/health.
KAFKA_OUTBOX_MAX_ATTEMPTS=10
# How often the background dispatcher looks for PENDING events (ms).
KAFKA_OUTBOX_DISPATCH_INTERVAL_MS=2000
# Day 8: a row that FAILED to publish is deferred until its backoff expires
# (1s -> 2s -> 4s ... capped), stored in `outbox_events.next_attempt_at`. Before
# this existed the 2s poll consumed the 10-attempt budget in ~20 seconds, so a
# routine broker restart dead-lettered everything queued. These two values are
# what make MAX_ATTEMPTS a budget spread over minutes instead of seconds.
KAFKA_OUTBOX_RETRY_BASE_DELAY_MS=1000
KAFKA_OUTBOX_RETRY_MAX_DELAY_MS=60000
# Events published per round, so each tick stays bounded.
KAFKA_OUTBOX_BATCH_SIZE=50

# Client-side timeouts: a publish must never sit on a dead socket for minutes -
# the event is retried from the outbox instead.
KAFKA_CONNECTION_TIMEOUT_MS=3000
KAFKA_REQUEST_TIMEOUT_MS=5000

# ----------------------------------------------------------------------------
# Observability & lifecycle (Day 8) - logs, request ids, metrics, shutdown
# ----------------------------------------------------------------------------
# Which deployable a log line came from. The API and the worker share one
# codebase and one log shape, so this (plus `pid` and `role` on the startup
# lines) is how their lines are told apart in one stream.
SERVICE_NAME="ecommerce-platform-backend"

# debug | info | warn | error | silent. `debug` locally, `info` when deployed.
# The access log is ONE line per request; at `debug` the cache also logs every
# hit/miss, which is noisy but is how you verify cache behaviour live.
LOG_LEVEL=info

# Optional bearer token for GET /api/metrics. Unset = the endpoint is open,
# which is right locally; set it anywhere else because the payload describes
# internal counters, backlogs and process ids.
# METRICS_TOKEN=""

# Graceful shutdown budget (ms). SIGTERM/SIGINT runs a named step list:
# stop background work -> drain HTTP -> close Kafka -> Redis -> Prisma.
# SHUTDOWN_DRAIN_TIMEOUT_MS is how long in-flight REQUESTS get; the force-exit
# watchdog covers the whole SHUTDOWN_TIMEOUT_MS and logs which step was still
# running when it fired. Keep SHUTDOWN_TIMEOUT_MS below the platform's
# terminationGracePeriod / idle timeout, or the platform kills us first and
# reports nothing.
SHUTDOWN_DRAIN_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

# Number of proxy hops to trust for req.ip / X-Forwarded-For (or true/false).
# The login rate limiter keys on req.ip: trusting a header any client can set
# lets it choose its own bucket, so the default is FALSE and production config
# refuses to start with TRUST_PROXY=true (give a hop count, e.g. 1, instead).
TRUST_PROXY=false

# Comma-separated CORS allowlist. Outside development '*' is refused at startup:
# a wildcard that also allows credentials is a vulnerability, not a default.
# CORS_ORIGINS="https://app.example.com"