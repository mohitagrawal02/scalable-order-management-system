# ============================================================================
# Backend environment configuration (example / template)
# ============================================================================
# Copy this file to `.env` and fill in real values for your machine.
# Never commit the real `.env`.

DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"
PORT=4000
NODE_ENV=development

# ----------------------------------------------------------------------------
# JWT (JSON Web Token) configuration
# ----------------------------------------------------------------------------
# JWT_SECRET signs and verifies access tokens. MUST be a random value of at
# least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="replace-with-a-random-secret-at-least-32-chars-long"
# How long an access token stays valid: '15m', '1h', '7d' (or seconds).
JWT_EXPIRES_IN="15m"

# ----------------------------------------------------------------------------
# Redis (Day 6) - product catalog cache + login rate limiting
# ----------------------------------------------------------------------------
# Redis is an OPTIMISATION layer, not a requirement: if it is unreachable the
# API keeps working (cache misses fall back to MySQL, rate limiting fails
# open) and only logs the degradation. See docs/REDIS.md.
#
# Local development (any of these - your choice):
#   docker:  docker compose -f docker-compose.redis.yml up -d
#   windows: redis-server.exe --port 6379 --dir .\redis-local-data
REDIS_URL="redis://127.0.0.1:6379"

# Client-side per-command timeout (ms). A slower Redis is treated as a cache
# error, so a sick cache can never stall an HTTP request.
REDIS_COMMAND_TIMEOUT_MS=500

# ----------------------------------------------------------------------------
# Product catalog cache
# ----------------------------------------------------------------------------
# TTL (seconds) for cached product list/detail responses. This is the worst
# case staleness if an invalidation is ever missed: short = fresher but more
# MySQL load, long = cheaper but staler. 60s is a deliberate starting point.
PRODUCT_CACHE_TTL_SECONDS=60

# ----------------------------------------------------------------------------
# Login rate limiting
# ----------------------------------------------------------------------------
# Attempts allowed per (client IP + target account) inside the window below.
# 5 attempts / 60s is a DEVELOPMENT default for a learning project - it is not
# a universal security recommendation. Tune per environment and document why.
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60