// ============================================================================
// E-Commerce Platform - Prisma Schema
// ============================================================================
// MySQL is the primary database (see docs/ARCHITECTURE.md for rationale).
//
// Design conventions used throughout this schema:
//   * Surrogate auto-increment integer primary keys (simple, index-friendly).
//     Public-facing identifiers (UUIDs / cuid) can be added later if needed.
//   * Money values use Decimal(10,2) - precise, not floating point.
//   * Enums for columns that have a fixed, known set of states.
//   * Relations use clear onDelete behaviour (Restrict / Cascade / SetNull).
//   * Indexes are added ONLY where a concrete query pattern already exists.
//     Foreign keys are indexed automatically by MySQL - we do not repeat them.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Users & Roles
// ----------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique @db.VarChar(255)
  passwordHash String @map("password_hash") @db.VarChar(255)
  name         String
  role         Role   @default(CUSTOMER)

  cart          Cart?          @relation("CartOwner")
  orders        Order[]
  notifications Notification[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ----------------------------------------------------------------------------
// Product Catalog
// ----------------------------------------------------------------------------

model Product {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(255)
  description String  @db.Text
  price       Decimal @db.Decimal(10, 2)
  currency    String  @default("USD") @db.VarChar(3)
  sku         String  @unique @db.VarChar(64)
  category    String  @db.VarChar(100)
  isActive    Boolean @default(true) @map("is_active")

  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Category is a first-class browse filter (Day 1).
  @@index([category], map: "idx_products_category")
  // minPrice/maxPrice range filtering is a first-class browse filter (Day 3);
  // a plain B-tree index turns `price BETWEEN x AND y` into an index range
  // scan instead of a full table scan.
  @@index([price], map: "idx_products_price")
  @@map("products")
}

// ----------------------------------------------------------------------------
// Inventory
// ----------------------------------------------------------------------------
// Stock is tracked separately from the catalog so that the product catalog
// and high-frequency stock writes can evolve independently.

model Inventory {
  id               Int @id @default(autoincrement())
  productId        Int @unique @map("product_id")
  quantity         Int @default(0)
  reservedQuantity Int @default(0) @map("reserved_quantity")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("inventory")
}

// ----------------------------------------------------------------------------
// Shopping Cart
// ----------------------------------------------------------------------------

model Cart {
  id     Int @id @default(autoincrement())
  userId Int @unique @map("user_id")

  user  User       @relation("CartOwner", fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id        Int @id @default(autoincrement())
  cartId    Int @map("cart_id")
  productId Int @map("product_id")
  quantity  Int @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  // One row per (cart, product) - adding a product twice upserts instead.
  @@unique([cartId, productId], map: "uq_cart_items_cart_product")
  @@map("cart_items")
}

// ----------------------------------------------------------------------------
// Orders
// ----------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  PAYMENT_PROCESSING
  PAID
  FULFILLED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id              Int         @id @default(autoincrement())
  orderNumber     String      @unique @map("order_number") @db.VarChar(32)
  userId          Int         @map("user_id")
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(10, 2)
  shippingAddress String      @map("shipping_address") @db.VarChar(500)

  user    User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items   OrderItem[]
  payment Payment?

  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  notifications Notification[]

  // "My orders" browsing for a user is THE core query in Day-2 work.
  @@index([userId], map: "idx_orders_user_id")
  // Admin "orders by status" list is a core admin query later.
  @@index([status], map: "idx_orders_status")
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  productId Int     @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("order_items")
}

// ----------------------------------------------------------------------------
// Payments
// ----------------------------------------------------------------------------
// Simulated payment processing for now (no real PSP integration).

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
  COD
}

model Payment {
  id             Int           @id @default(autoincrement())
  orderId        Int           @unique @map("order_id")
  amount         Decimal       @db.Decimal(10, 2)
  status         PaymentStatus @default(PENDING)
  method         PaymentMethod
  transactionRef String?       @unique @map("transaction_ref") @db.VarChar(64)

  // Added in Day 5 ----------------------------------------------------------
  // Idempotency: two identical client requests (e.g. a retry after a lost
  // response) must collapse into ONE logical payment. The UNIQUE constraint -
  // not a read-then-write check - is what makes that safe under concurrency,
  // so it gets its own index for the replay lookup by key.
  idempotencyKey String? @unique @map("idempotency_key") @db.VarChar(191)
  // `orderId` is unique (one payment row per order), so retry history is
  // summarized on this row instead of in a separate attempts table.
  attemptCount  Int     @default(0) @map("attempt_count")
  failureReason String? @map("failure_reason") @db.VarChar(255)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // No index on `status`: nothing queries payments by status yet. Adding one
  // now would be speculation (see docs/ARCHITECTURE.md index policy).

  @@map("payments")
}

// ----------------------------------------------------------------------------
// Notifications
// ----------------------------------------------------------------------------

enum NotificationType {
  ORDER_CONFIRMED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  ORDER_SHIPPED
  ORDER_CANCELLED
  ORDER_DELIVERED
}

model Notification {
  id      Int              @id @default(autoincrement())
  userId  Int              @map("user_id")
  orderId Int?             @map("order_id")
  type    NotificationType
  message String           @db.VarChar(500)
  isRead  Boolean          @default(false) @map("is_read")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  // "Latest notifications for a user, newest first" is the core query.
  @@index([userId, createdAt], map: "idx_notifications_user_created")
  @@map("notifications")
}

// ----------------------------------------------------------------------------
// Day 7: event-driven side effects (outbox + consumer idempotency)
// ----------------------------------------------------------------------------
// These two tables are INFRASTRUCTURE, not domain: they make the MySQL → Kafka
// hand-off reliable. Both are deliberately FK-free (no `orderId`/`paymentId`
// columns) so a stuck or dead-lettered event can never block deleting the
// business row it talks about, and so this table does not grow a second,
// competing copy of the domain model.

enum OutboxEventStatus {
  /// Committed with the business transaction, not yet accepted by Kafka.
  PENDING
  /// Acknowledged by the broker (at-least-once: a duplicate publish is allowed
  /// and is exactly what consumer idempotency exists to absorb).
  PUBLISHED
  /// Gave up after `attempts` tries. Kept for inspection/ops, no longer retried.
  DEAD
}

/// Transactional outbox: the row is written by the SAME transaction that
/// changes business state, which removes the dual-write problem (see
/// docs/KAFKA.md §6). The full event envelope is stored as-is so publishing is
/// a straight read → serialize → send, with no reconstruction step that could
/// drift from what the producer originally meant.
model OutboxEvent {
  id            Int              @id @default(autoincrement())
  /// UUIDv4. Carried in the envelope and used by consumers for deduplication.
  eventId       String           @unique @map("event_id") @db.VarChar(36)
  topic         String           @db.VarChar(120)
  eventType     String           @map("event_type") @db.VarChar(80)
  aggregateType String           @map("aggregate_type") @db.VarChar(40)
  aggregateId   String           @map("aggregate_id") @db.VarChar(64)
  /// Kafka message key: everything for one aggregate must keep its order.
  partitionKey  String           @map("partition_key") @db.VarChar(64)
  /// The complete serialized event envelope.
  envelope      Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int              @default(0)
  lastError     String?          @map("last_error") @db.VarChar(500)
  occurredAt    DateTime         @map("occurred_at")
  publishedAt   DateTime?        @map("published_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  /// The dispatcher's only query: "oldest still-pending events, in id order".
  /// `id` is included so the scan is covered by this index instead of sorting.
  @@index([status, id], map: "idx_outbox_status_id")
  @@map("outbox_events")
}

/// Consumer-side deduplication ledger.
///
/// Kafka guarantees at-least-once delivery, so a consumer WILL eventually see
/// the same event twice (rebalance, retry after a partially-applied batch, a
/// duplicate outbox publish). The unique constraint on
/// (consumer_group, event_id) is what turns "at-least-once delivery" into
/// "effectively-once effect": the second delivery hits a duplicate-key error
/// and is skipped.
model ProcessedEvent {
  id            Int      @id @default(autoincrement())
  /// Scopes the ledger per group, so two independent consumers may each
  /// legitimately process the same event.
  consumerGroup String   @map("consumer_group") @db.VarChar(80)
  eventId       String   @map("event_id") @db.VarChar(36)
  eventType     String   @map("event_type") @db.VarChar(80)
  processedAt   DateTime @default(now()) @map("processed_at")

  @@unique([consumerGroup, eventId], map: "uq_processed_events_group_event")
  /// Supports the retention sweep that keeps this ledger from growing forever.
  @@index([processedAt], map: "idx_processed_events_processed_at")
  @@map("processed_events")
}
